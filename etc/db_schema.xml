<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="aw_fei_sp_basket_item" resource="default" engine="innodb"
           comment="FEI Special Pricing Basket Item">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false"
                comment="Customer ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false"
                comment="Product ID"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" unsigned="false" nullable="false"
                default="1" comment="Qty"/>
        <column xsi:type="text" name="buy_request" nullable="true" comment="Serialized buy request (JSON)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="AW_FEI_SP_BASKET_ITEM_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="aw_fei_sp_basket_item" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="AW_FEI_SP_BASKET_ITEM_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="aw_fei_sp_basket_item" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="AW_FEI_SP_BASKET_ITEM_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="aw_fei_sp_request" resource="default" engine="innodb" comment="FEI Special Pricing Request">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="company_id" padding="10" unsigned="true" nullable="false"
                comment="Company ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false"
                comment="Customer ID"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false"
                comment="Store ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="pending"
                comment="pending / approved / rejected / expired / ordered"/>
        <column xsi:type="text" name="customer_comment" nullable="true" comment="Customer Comment"/>
        <column xsi:type="text" name="admin_comment" nullable="true" comment="FEI Comment"/>
        <column xsi:type="datetime" name="expires_at" nullable="true" comment="Approved prices valid until"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true"
                comment="Order placed with approved prices"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="AW_FEI_SP_REQUEST_COMPANY_ID_AW_CA_COMPANY_ID"
                    table="aw_fei_sp_request" column="company_id"
                    referenceTable="aw_ca_company" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="AW_FEI_SP_REQUEST_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="aw_fei_sp_request" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="AW_FEI_SP_REQUEST_STORE_ID_STORE_STORE_ID"
                    table="aw_fei_sp_request" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="AW_FEI_SP_REQUEST_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="aw_fei_sp_request" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="AW_FEI_SP_REQUEST_COMPANY_ID" indexType="btree">
            <column name="company_id"/>
        </index>
        <index referenceId="AW_FEI_SP_REQUEST_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="AW_FEI_SP_REQUEST_STATUS_EXPIRES_AT" indexType="btree">
            <column name="status"/>
            <column name="expires_at"/>
        </index>
    </table>

    <table name="aw_fei_sp_request_item" resource="default" engine="innodb"
           comment="FEI Special Pricing Request Item">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="request_id" padding="10" unsigned="true" nullable="false"
                comment="Request ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="true"
                comment="Product ID"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="SKU"/>
        <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Product Name"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" unsigned="false" nullable="false"
                default="1" comment="Qty"/>
        <column xsi:type="decimal" name="original_price" scale="4" precision="20" unsigned="false"
                nullable="true" comment="Price at request time"/>
        <column xsi:type="decimal" name="special_price" scale="4" precision="20" unsigned="false"
                nullable="true" comment="Approved special price"/>
        <column xsi:type="text" name="buy_request" nullable="true" comment="Serialized buy request (JSON)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="AW_FEI_SP_REQUEST_ITEM_REQUEST_ID_AW_FEI_SP_REQUEST_ID"
                    table="aw_fei_sp_request_item" column="request_id"
                    referenceTable="aw_fei_sp_request" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="AW_FEI_SP_REQUEST_ITEM_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="aw_fei_sp_request_item" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="AW_FEI_SP_REQUEST_ITEM_REQUEST_ID" indexType="btree">
            <column name="request_id"/>
        </index>
    </table>

    <table name="quote_item" resource="checkout">
        <column xsi:type="int" name="aw_fei_sp_request_item_id" padding="10" unsigned="true" nullable="true"
                comment="FEI Special Pricing Request Item ID"/>
    </table>
    <table name="sales_order_item" resource="sales">
        <column xsi:type="int" name="aw_fei_sp_request_item_id" padding="10" unsigned="true" nullable="true"
                comment="FEI Special Pricing Request Item ID"/>
    </table>
</schema>
