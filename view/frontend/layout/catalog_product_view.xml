<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.addtocart">
            <block class="Magento\Catalog\Block\Product\View"
                   name="aw.fei.sp.product.addtocart.button"
                   as="aw_fei_sp_button"
                   template="Aheadworks_FeiSpecialPricing::product/view/add_button.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Aheadworks\FeiSpecialPricing\ViewModel\AddButton</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional">
            <block class="Magento\Catalog\Block\Product\View"
                   name="aw.fei.sp.product.addtocart.additional.button"
                   as="aw_fei_sp_button"
                   template="Aheadworks_FeiSpecialPricing::product/view/add_button.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Aheadworks\FeiSpecialPricing\ViewModel\AddButton</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.bundle">
            <block class="Magento\Catalog\Block\Product\View"
                   name="aw.fei.sp.product.addtocart.bundle.button"
                   as="aw_fei_sp_button"
                   template="Aheadworks_FeiSpecialPricing::product/view/add_button.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Aheadworks\FeiSpecialPricing\ViewModel\AddButton</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
