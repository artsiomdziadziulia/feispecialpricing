<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">aw_fei_sp_request_form.aw_fei_sp_request_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Special Pricing Request</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Aheadworks\FeiSpecialPricing\Block\Adminhtml\Request\Edit\BackButton"/>
            <button name="reject" class="Aheadworks\FeiSpecialPricing\Block\Adminhtml\Request\Edit\RejectButton"/>
            <button name="approve" class="Aheadworks\FeiSpecialPricing\Block\Adminhtml\Request\Edit\ApproveButton"/>
        </buttons>
        <namespace>aw_fei_sp_request_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>aw_fei_sp_request_form.aw_fei_sp_request_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="aw_fei_sp_request_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="aw_fei_sp_admin/request/save"/>
        </settings>
        <dataProvider class="Aheadworks\FeiSpecialPricing\Ui\DataProvider\Request\FormDataProvider"
                      name="aw_fei_sp_request_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Request Information</label>
        </settings>
        <field name="id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="status_label" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
            </settings>
        </field>
        <field name="company_name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Company</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
            </settings>
        </field>
        <field name="customer" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Requested By</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
            </settings>
        </field>
        <field name="created_at" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Created</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
            </settings>
        </field>
        <field name="customer_comment" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Customer Comment</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
            </settings>
        </field>
        <field name="order_id" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Order ID</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
            </settings>
        </field>
    </fieldset>

    <fieldset name="items_fieldset" sortOrder="20">
        <settings>
            <label translate="true">Items and Special Prices</label>
        </settings>
        <dynamicRows name="items">
            <settings>
                <addButton>false</addButton>
                <componentType>dynamicRows</componentType>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="id" formElement="input">
                    <settings>
                        <dataType>text</dataType>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="sku" formElement="input" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">SKU</label>
                        <elementTmpl>ui/form/element/text</elementTmpl>
                    </settings>
                </field>
                <field name="name" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Product</label>
                        <elementTmpl>ui/form/element/text</elementTmpl>
                    </settings>
                </field>
                <field name="qty" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Qty</label>
                        <elementTmpl>ui/form/element/text</elementTmpl>
                    </settings>
                </field>
                <field name="original_price" formElement="input" sortOrder="40">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Regular Price</label>
                        <elementTmpl>ui/form/element/text</elementTmpl>
                    </settings>
                </field>
                <field name="special_price" formElement="input" sortOrder="50">
                    <settings>
                        <dataType>price</dataType>
                        <label translate="true">Special Price</label>
                        <validation>
                            <rule name="validate-number" xsi:type="boolean">true</rule>
                            <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
            </container>
        </dynamicRows>
    </fieldset>

    <fieldset name="decision" sortOrder="30">
        <settings>
            <label translate="true">Decision</label>
        </settings>
        <field name="expires_at" formElement="date" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Prices Valid Until</label>
                <notice translate="true">Approved prices can be used until the end of this day (store timezone). Leave empty to use the default validity period.</notice>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <options>
                            <option name="dateFormat" xsi:type="string">yyyy-MM-dd</option>
                        </options>
                        <inputDateFormat>y-MM-dd</inputDateFormat>
                        <outputDateFormat>y-MM-dd</outputDateFormat>
                    </settings>
                </date>
            </formElements>
        </field>
        <field name="admin_comment" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Comment for Customer</label>
            </settings>
        </field>
    </fieldset>
</form>
